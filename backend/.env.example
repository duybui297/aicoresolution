POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=your-postgres-container
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=your_postgres_host_port
POSTGRES_CONTAINER_PORT=your_postgres_container_port

DB_URL=jdbc:postgresql://your_db_host:your_db_port/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
APP_CORS_ALLOWED_ORIGINS=http://your-frontend-origin
APP_UPLOAD_DIR=your_upload_directory_path
APP_JWT_SECRET=your_jwt_secret_key
APP_ACCESS_TOKEN_MINUTES=your_access_token_minutes
